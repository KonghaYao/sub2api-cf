{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub2api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_VERSION": "0.45.2",
    "GROUP_USAGE_TIMEZONE": "Asia/Shanghai",
    "BATCH_PROVIDER_JOBS_ENABLED": "false",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "WEBAUTHN_RP_ID": "localhost",
    "WEBAUTHN_RP_NAME": "Sub2API Development",
    "WEBAUTHN_RP_ORIGINS": "[\"http://localhost:8787\"]"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/ready",
      "/internal",
      "/internal/*",
      "/api",
      "/api/*",
      "/v1",
      "/v1/*",
      "/models",
      "/chat/completions",
      "/messages",
      "/messages/*",
      "/embeddings",
      "/responses",
      "/responses/*",
      "/v1beta",
      "/v1beta/*",
      "/backend-api",
      "/backend-api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub2api-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "sub2api-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "sub2api-events-dev"
      }
    ],
    "consumers": [
      {
        "queue": "sub2api-events-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "sub2api-events-dev-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_STATE",
        "class_name": "UserStateDO"
      },
      {
        "name": "SUBSCRIPTION_STATE",
        "class_name": "SubscriptionStateDO"
      },
      {
        "name": "POOL_STATE",
        "class_name": "PoolStateDO"
      },
      {
        "name": "AUTH_RATE_LIMIT",
        "class_name": "AuthRateLimitDO"
      },
      {
        "name": "API_KEY_LIMIT_STATE",
        "class_name": "ApiKeyLimitDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserStateDO", "PoolStateDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AuthRateLimitDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SubscriptionStateDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ApiKeyLimitDO"]
    }
  ],
  "env": {
    "staging": {
      "name": "sub2api-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "0.45.2",
        "GROUP_USAGE_TIMEZONE": "Asia/Shanghai",
        "BATCH_PROVIDER_JOBS_ENABLED": "false",
        "PUBLIC_ORIGIN": "https://sub2api-worker-staging.claude-code-best.workers.dev",
        "WEBAUTHN_RP_ID": "sub2api-worker-staging.claude-code-best.workers.dev",
        "WEBAUTHN_RP_NAME": "Sub2API Staging",
        "WEBAUTHN_RP_ORIGINS": "[\"https://sub2api-worker-staging.claude-code-best.workers.dev\"]"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sub2api-staging",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "11111111111111111111111111111111"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS",
          "bucket_name": "sub2api-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS_QUEUE",
            "queue": "sub2api-events-staging"
          }
        ],
        "consumers": [
          {
            "queue": "sub2api-events-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "dead_letter_queue": "sub2api-events-staging-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "USER_STATE",
            "class_name": "UserStateDO"
          },
          {
            "name": "SUBSCRIPTION_STATE",
            "class_name": "SubscriptionStateDO"
          },
          {
            "name": "POOL_STATE",
            "class_name": "PoolStateDO"
          },
          {
            "name": "AUTH_RATE_LIMIT",
            "class_name": "AuthRateLimitDO"
          },
          {
            "name": "API_KEY_LIMIT_STATE",
            "class_name": "ApiKeyLimitDO"
          }
        ]
      },
      "triggers": {
        "crons": ["* * * * *"]
      }
    },
    "production": {
      "name": "sub2api-worker-production",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "0.45.2",
        "GROUP_USAGE_TIMEZONE": "Asia/Shanghai",
        "BATCH_PROVIDER_JOBS_ENABLED": "false",
        "PUBLIC_ORIGIN": "https://sub2api-worker-production.claude-code-best.workers.dev",
        "WEBAUTHN_RP_ID": "sub2api-worker-production.claude-code-best.workers.dev",
        "WEBAUTHN_RP_NAME": "Sub2API",
        "WEBAUTHN_RP_ORIGINS": "[\"https://sub2api-worker-production.claude-code-best.workers.dev\"]"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sub2api-production",
          "database_id": "4e7f582b-3aee-441c-b544-8d38f10ec5d4",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "dbed85df39ad4bc78c311f3b872974d4"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS",
          "bucket_name": "sub2api-production"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS_QUEUE",
            "queue": "sub2api-events-production"
          }
        ],
        "consumers": [
          {
            "queue": "sub2api-events-production",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "dead_letter_queue": "sub2api-events-production-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "USER_STATE",
            "class_name": "UserStateDO"
          },
          {
            "name": "SUBSCRIPTION_STATE",
            "class_name": "SubscriptionStateDO"
          },
          {
            "name": "POOL_STATE",
            "class_name": "PoolStateDO"
          },
          {
            "name": "AUTH_RATE_LIMIT",
            "class_name": "AuthRateLimitDO"
          },
          {
            "name": "API_KEY_LIMIT_STATE",
            "class_name": "ApiKeyLimitDO"
          }
        ]
      },
      "triggers": {
        "crons": ["* * * * *"]
      }
    }
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
