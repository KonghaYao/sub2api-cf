{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub2api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_VERSION": "0.1.0"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/ready",
      "/api",
      "/api/*",
      "/v1",
      "/v1/*",
      "/responses",
      "/backend-api",
      "/backend-api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub2api-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "sub2api-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "sub2api-events-dev"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_STATE",
        "class_name": "UserStateDO"
      },
      {
        "name": "POOL_STATE",
        "class_name": "PoolStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserStateDO", "PoolStateDO"]
    }
  ],
  "env": {
    "staging": {
      "name": "sub2api-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "0.1.0"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sub2api-staging",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "11111111111111111111111111111111"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS",
          "bucket_name": "sub2api-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS_QUEUE",
            "queue": "sub2api-events-staging"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "USER_STATE",
            "class_name": "UserStateDO"
          },
          {
            "name": "POOL_STATE",
            "class_name": "PoolStateDO"
          }
        ]
      }
    },
    "production": {
      "name": "sub2api-worker-production",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "0.1.0"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sub2api-production",
          "database_id": "22222222-2222-2222-2222-222222222222",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "22222222222222222222222222222222"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS",
          "bucket_name": "sub2api-production"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS_QUEUE",
            "queue": "sub2api-events-production"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "USER_STATE",
            "class_name": "UserStateDO"
          },
          {
            "name": "POOL_STATE",
            "class_name": "PoolStateDO"
          }
        ]
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
