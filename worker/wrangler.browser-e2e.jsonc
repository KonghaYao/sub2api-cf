{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub2api-worker-browser-e2e",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "browser-e2e",
    "APP_VERSION": "browser-e2e",
    "BATCH_PROVIDER_JOBS_ENABLED": "false",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8791",
    "WEBAUTHN_RP_ID": "127.0.0.1",
    "WEBAUTHN_RP_NAME": "Sub2API Browser E2E",
    "WEBAUTHN_RP_ORIGINS": "[\"http://127.0.0.1:8791\"]",
    "ADMIN_TOKEN": "browser-e2e-admin-token-32-bytes-minimum",
    "API_KEY_PEPPER": "browser-e2e-api-key-pepper-32-bytes-minimum",
    "CREDENTIALS_MASTER_KEY": "browser-e2e-credentials-master-key-32-bytes"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/ready",
      "/api",
      "/api/*",
      "/v1",
      "/v1/*",
      "/models",
      "/chat/completions",
      "/messages",
      "/messages/*",
      "/embeddings",
      "/responses",
      "/responses/*",
      "/v1beta",
      "/v1beta/*",
      "/backend-api",
      "/backend-api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub2api-browser-e2e",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "00000000000000000000000000000002"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "sub2api-browser-e2e"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "sub2api-events-browser-e2e"
      }
    ],
    "consumers": [
      {
        "queue": "sub2api-events-browser-e2e",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 1,
        "dead_letter_queue": "sub2api-events-browser-e2e-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER_STATE", "class_name": "UserStateDO" },
      { "name": "SUBSCRIPTION_STATE", "class_name": "SubscriptionStateDO" },
      { "name": "POOL_STATE", "class_name": "PoolStateDO" },
      { "name": "AUTH_RATE_LIMIT", "class_name": "AuthRateLimitDO" },
      { "name": "API_KEY_LIMIT_STATE", "class_name": "ApiKeyLimitDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserStateDO", "PoolStateDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AuthRateLimitDO"] },
    { "tag": "v3", "new_sqlite_classes": ["SubscriptionStateDO"] },
    { "tag": "v4", "new_sqlite_classes": ["ApiKeyLimitDO"] }
  ]
}
